#Répértoire du code map-reduce
CODE_PYTHON_DIR=../map-reduce
# Environment variables for test configurations
TEST_WORKSPACE=/tmp/test_workspace

# Define the target directory for splits
SPLITS_TARGET_DIR=${TEST_WORKSPACE}/splits
# books or commoncrawl
SPLITS_DATASET_TYPE="books"

# Fichier pour stocker l'ID du job en cours
JOB_ID_FILE=${TEST_WORKSPACE}/.current_job_id
JOB_ID=""

# Configurations du serveur master
MASTER_HOST="127.0.0.1"
MASTER_PORT=8000
AMDAL_RESULT_FILE_PATH=${TEST_WORKSPACE}"/execution_results.csv"
# Laissez vide  pour traiter tous les splits.
SPLIT_LIMIT="5"  

# Configuration des workers
# Le nombre de workers est maintenant calculé depuis la liste
NUM_WORKERS=4 
# Option par défaut, peut être modifiée si besoin (ram ou disk)
SHUFFLE_MODE="ram"
# Port de base pour les workers (les ports seront incrémentés à partir de celui-ci)
WORKERS_INITIAL_PORT=9000
# Taille du batch pour le shuffle
SHUFFLE_BATCH_SIZE=10000
