#Répértoire du code map-reduce
CODE_PYTHON_DIR=../map-reduce
# Environment variables for test configurations
TEST_WORKSPACE=/tmp/test_workspace

# script python pour le master
MASTER_SCRIPT="ybt_master_map_reduce.py"
# script python pour les worker
WORKER_SCRIPT="ybt_worker_map_reduce.py"
# Fichier pour stocker l'ID du job en cours
JOB_ID_FILE=${TEST_WORKSPACE}/.current_job_id
JOB_ID=""

# La liste des machine récupérées via l'API ou le cache
API_URL="https://tp.telecom-paris.fr/ajax.php"
#SSH user et suffixe DNS
SSH_USER="boutrouft-25"
DNS_SUFFIX=".enst.fr"

# 2. CACHE ET FALLBACK
CACHE_FILE=".serveurs_disponible_cache"
WORKERS_CACHE_FILE=".workers_a_demarre_cache"
MASTER_NFS_SERVEUR_CACHE_FILE=".master_nfs_serveur_cache"
DEFAULT_WORKERS=(
    "${SSH_USER}@tp-1a201-18${DNS_SUFFIX}"
    "${SSH_USER}@tp-1a201-19${DNS_SUFFIX}"
    "${SSH_USER}@tp-1a201-20${DNS_SUFFIX}"
)

# 3. DÉTAILS DU SERVEUR NFS
REMOTE_PATH="/cal/exterieurs/${SSH_USER}/distributed_systems"
DATA_PATH="/cal/commoncrawl"
AMDAL_RESULT_FILE_PATH="$REMOTE_PATH/amdahl_results.csv"

# 4. DÉTAILS DU MASTER
MASTER_PORT=8000
SPLIT_LIMIT="1" 

# 5.Détail du worker(s)
SHUFFLE_PORT_START=9001
SHUFFLE_MODE="ram"
BATCH_SIZE=100000
NUM_WORKERS_TO_LAUNCH="1" 


# 6. OPTIONS DE DÉMARRAGE
RATE_LIMIT=0 
SSH_DELAY=12
